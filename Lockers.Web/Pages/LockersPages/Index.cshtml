@page
@model Lockers.Web.Pages.LockersPages.IndexModel
@{
    ViewData["Title"] = "Lockers";
}

<div class="container mt-4">
    <h2 style="color:white; font-weight:700;"><i class="fas fa-door-closed me-2"></i>Lockers</h2>
    <a href="/LockersPages/Create" class="btn btn-primary mb-3">+ New Locker</a>
    <table class="table table-dark table-striped table-hover">
        <thead>
            <tr>
                <th>Number</th>
                <th>Location</th>
                <th>Size</th>
                <th>Status</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var locker in Model.LockerList)
            {
                <tr>
                    <td>@locker.Number</td>
                    <td>@locker.Location</td>
                    <td>@locker.Size</td>
                    <td>@locker.Status</td>
                    <td>
                        <a href="/LockersPages/Delete?id=@locker.Id" class="btn btn-sm btn-danger">Delete</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>