@page
@model Lockers.Web.Pages.LockersPages.CreateModel
@{
    ViewData["Title"] = "New Locker";
}

<div class="container mt-4" style="max-width:600px;">
    <h2 style="color:white; font-weight:700;"><i class="fas fa-plus me-2"></i>New Locker</h2>
    <div style="background:#16213e; border-radius:16px; padding:30px; border:1px solid rgba(108,99,255,0.3);">
        <form method="post">
            <div class="mb-3">
                <label class="form-label" style="color:#a0a0b0;">Number</label>
                <input asp-for="Locker.Number" class="form-control bg-dark text-white border-secondary" />
            </div>
            <div class="mb-3">
                <label class="form-label" style="color:#a0a0b0;">Location</label>
                <input asp-for="Locker.Location" class="form-control bg-dark text-white border-secondary" />
            </div>
            <div class="mb-3">
                <label class="form-label" style="color:#a0a0b0;">Size</label>
                <select asp-for="Locker.Size" class="form-control bg-dark text-white border-secondary">
                    <option>Small</option>
                    <option>Medium</option>
                    <option>Large</option>
                </select>
            </div>
            <div class="d-flex gap-2">
                <button type="submit" class="btn-primary-custom">Save</button>
                <a href="/LockersPages" class="btn btn-secondary">Cancel</a>
            </div>
        </form>
    </div>
</div>