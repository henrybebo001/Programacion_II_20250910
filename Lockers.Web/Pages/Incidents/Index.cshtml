@page
@model Lockers.Web.Pages.Incidents.IndexModel
@{
    ViewData["Title"] = "Incidents";
}

<div class="container mt-4">
    <h2 style="color:white; font-weight:700;"><i class="fas fa-exclamation-triangle me-2"></i>Incidents</h2>
    <a href="/Incidents/Create" class="btn btn-primary mb-3">+ New Incident</a>
    <table class="table table-dark table-striped table-hover">
        <thead>
            <tr>
                <th>Type</th>
                <th>Description</th>
                <th>Assignment ID</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var incident in Model.IncidentList)
            {
                <tr>
                    <td>@incident.Type</td>
                    <td>@incident.Description</td>
                    <td>@incident.AssignmentId</td>
                    <td>
                        <a href="/Incidents/Delete?id=@incident.Id" class="btn btn-sm btn-danger">Delete</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>