@page
@model Lockers.Web.Pages.Incidents.CreateModel
@{
    ViewData["Title"] = "New Incident";
}

<div class="container mt-4" style="max-width:600px;">
    <h2 style="color:white; font-weight:700;"><i class="fas fa-exclamation-triangle me-2"></i>New Incident</h2>
    <div style="background:#16213e; border-radius:16px; padding:30px; border:1px solid rgba(108,99,255,0.3);">
        <form method="post">
            <div class="mb-3">
                <label class="form-label" style="color:#a0a0b0;">Type</label>
                <select asp-for="Incident.Type" class="form-control bg-dark text-white border-secondary">
                    <option>Damage</option>
                    <option>LostKey</option>
                    <option>Complaint</option>
                    <option>Other</option>
                </select>
            </div>
            <div class="mb-3">
                <label class="form-label" style="color:#a0a0b0;">Description</label>
                <textarea asp-for="Incident.Description" class="form-control bg-dark text-white border-secondary" rows="3"></textarea>
            </div>
            <div class="mb-3">
                <label class="form-label" style="color:#a0a0b0;">Assignment ID</label>
                <input asp-for="Incident.AssignmentId" type="number" class="form-control bg-dark text-white border-secondary" />
            </div>
            <div class="d-flex gap-2">
                <button type="submit" class="btn-primary-custom">Save</button>
                <a href="/Incidents" class="btn btn-secondary">Cancel</a>
            </div>
        </form>
    </div>
</div>