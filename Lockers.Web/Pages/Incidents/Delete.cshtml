@page
@model Lockers.Web.Pages.Incidents.DeleteModel
@{
    ViewData["Title"] = "Delete Incident";
}

<div class="container mt-4" style="max-width:600px;">
    <h2 style="color:white; font-weight:700;"><i class="fas fa-trash me-2"></i>Delete Incident</h2>
    <div style="background:#16213e; border-radius:16px; padding:30px; border:1px solid rgba(255,50,50,0.3);">
        <p style="color:#a0a0b0;">Are you sure you want to delete this incident?</p>
        <table class="table table-dark">
            <tr><th>Type</th><td>@Model.Incident.Type</td></tr>
            <tr><th>Description</th><td>@Model.Incident.Description</td></tr>
            <tr><th>Assignment ID</th><td>@Model.Incident.AssignmentId</td></tr>
        </table>
        <form method="post">
            <input type="hidden" name="id" value="@Model.Incident.Id" />
            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-danger">Yes, Delete</button>
                <a href="/Incidents" class="btn btn-secondary">Cancel</a>
            </div>
        </form>
    </div>
</div>