@page
@model Lockers.Web.Pages.Students.EditModel
@{
    ViewData["Title"] = "Edit Student";
}
<div class="container mt-4" style="max-width:600px;">
    <h2 style="color:white; font-weight:700;">
        <i class="fas fa-user-edit me-2"></i>Edit Student
    </h2>

    <form method="post" class="bg-dark p-4 rounded mt-3">
        <input type="hidden" asp-for="Student.Id" />

        <div class="mb-3">
            <label class="form-label text-white">Name</label>
            <input asp-for="Student.Name" class="form-control" required />
        </div>
        <div class="mb-3">
            <label class="form-label text-white">Student ID</label>
            <input asp-for="Student.StudentId" class="form-control" required />
        </div>
        <div class="mb-3">
            <label class="form-label text-white">Grade</label>
            <input asp-for="Student.Grade" class="form-control" />
        </div>
        <div class="mb-3">
            <label class="form-label text-white">Email</label>
            <input asp-for="Student.Email" class="form-control" type="email" />
        </div>

        <div class="d-flex gap-2">
            <button type="submit" class="btn btn-warning">
                <i class="fas fa-save me-1"></i>Save Changes
            </button>
            <a href="/Students/Index" class="btn btn-secondary">Cancel</a>
        </div>
    </form>
</div>