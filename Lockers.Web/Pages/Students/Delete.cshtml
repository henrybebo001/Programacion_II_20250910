@page
@model Lockers.Web.Pages.Students.DeleteModel
@{
    ViewData["Title"] = "Delete Student";
}

<div class="container mt-4" style="max-width:600px;">
    <h2 style="color:white; font-weight:700;"><i class="fas fa-trash me-2"></i>Delete Student</h2>
    <div style="background:#16213e; border-radius:16px; padding:30px; border:1px solid rgba(255,50,50,0.3);">
        <p style="color:#a0a0b0;">Are you sure you want to delete this student?</p>
        <table class="table table-dark">
            <tr><th>Name</th><td>@Model.Student.Name</td></tr>
            <tr><th>Student ID</th><td>@Model.Student.StudentId</td></tr>
            <tr><th>Grade</th><td>@Model.Student.Grade</td></tr>
            <tr><th>Email</th><td>@Model.Student.Email</td></tr>
        </table>
        <form method="post">
            <input type="hidden" name="id" value="@Model.Student.Id" />
            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-danger">Yes, Delete</button>
                <a href="/Students" class="btn btn-secondary">Cancel</a>
            </div>
        </form>
    </div>
</div>