@page
@model Lockers.Web.Pages.Students.IndexModel
@{
    ViewData["Title"] = "Students";
}

<div class="container mt-4">
    <h2 style="color:white; font-weight:700;"><i class="fas fa-user-graduate me-2"></i>Students</h2>
    <a href="/Students/Create" class="btn btn-primary mb-3">+ New Student</a>
    <table class="table table-dark table-striped table-hover">
        <thead>
            <tr>
                <th>Name</th>
                <th>Student ID</th>
                <th>Grade</th>
                <th>Email</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var student in Model.StudentList)
            {
                <tr>
                    <td>@student.Name</td>
                    <td>@student.StudentId</td>
                    <td>@student.Grade</td>
                    <td>@student.Email</td>
                    <td>
                        <a href="/Students/Edit?id=@student.Id" class="btn btn-sm btn-warning">Edit</a>
                        <a href="/Students/Delete?id=@student.Id" class="btn btn-sm btn-danger">Delete</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>