@page
@model Lockers.Web.Pages.Assignments.RenewModel
@{
    ViewData["Title"] = "Renew Assignment";
}

<div class="container mt-4" style="max-width:600px;">
    <h2 style="color:white; font-weight:700;"><i class="fas fa-sync me-2"></i>Renew Assignment</h2>
    <div style="background:#16213e; border-radius:16px; padding:30px; border:1px solid rgba(108,99,255,0.3);">
        <table class="table table-dark mb-4">
            <tr><th>Locker ID</th><td>@Model.Assignment.LockerId</td></tr>
            <tr><th>Student ID</th><td>@Model.Assignment.StudentId</td></tr>
            <tr><th>Current End Date</th><td>@Model.Assignment.EndDate.ToShortDateString()</td></tr>
        </table>
        <form method="post">
            <input type="hidden" name="id" value="@Model.Assignment.Id" />
            <div class="mb-3">
                <label class="form-label" style="color:#a0a0b0;">Extra Days</label>
                <input asp-for="ExtraDays" type="number" class="form-control bg-dark text-white border-secondary" value="30" />
            </div>
            <div class="d-flex gap-2">
                <button type="submit" class="btn-primary-custom">Renew</button>
                <a href="/Assignments" class="btn btn-secondary">Cancel</a>
            </div>
        </form>
    </div>
</div>