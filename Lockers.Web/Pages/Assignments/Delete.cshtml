@page
@model Lockers.Web.Pages.Assignments.DeleteModel
@{
    ViewData["Title"] = "Delete Assignment";
}

<div class="container mt-4" style="max-width:600px;">
    <h2 style="color:white; font-weight:700;"><i class="fas fa-trash me-2"></i>Delete Assignment</h2>
    <div style="background:#16213e; border-radius:16px; padding:30px; border:1px solid rgba(255,50,50,0.3);">
        <p style="color:#a0a0b0;">Are you sure you want to delete this assignment?</p>
        <table class="table table-dark">
            <tr><th>Locker ID</th><td>@Model.Assignment.LockerId</td></tr>
            <tr><th>Student ID</th><td>@Model.Assignment.StudentId</td></tr>
            <tr><th>Start Date</th><td>@Model.Assignment.StartDate.ToShortDateString()</td></tr>
            <tr><th>End Date</th><td>@Model.Assignment.EndDate.ToShortDateString()</td></tr>
        </table>
        <form method="post">
            <input type="hidden" name="id" value="@Model.Assignment.Id" />
            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-danger">Yes, Delete</button>
                <a href="/Assignments" class="btn btn-secondary">Cancel</a>
            </div>
        </form>
    </div>
</div>