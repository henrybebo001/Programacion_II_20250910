@page
@model Lockers.Web.Pages.Assignments.CreateModel
@{
    ViewData["Title"] = "New Assignment";
}

<link href="https://cdnjs.cloudflare.com/ajax/libs/select2/4.1.0-rc.0/css/select2.min.css" rel="stylesheet" />

<div class="container mt-4" style="max-width:600px;">
    <h2 style="color:white; font-weight:700;">
        <i class="fas fa-clipboard-plus me-2"></i>New Assignment
    </h2>

    <div style="background:#16213e; border-radius:16px; padding:30px; border:1px solid rgba(108,99,255,0.3);">
        
        <form method="post">

            @if (!ViewData.ModelState.IsValid)
            {
                <div class="alert alert-danger mb-3">
                    @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                    {
                        <p class="mb-0">❌ @error.ErrorMessage</p>
                    }
                </div>
            }

            <div class="mb-3">
                <label class="form-label" style="color:#a0a0b0;">Locker</label>
                <select asp-for="Assignment.LockerId" asp-items="Model.LockerOptions" class="form-control select2-locker" style="width:100%">
                    <option value="">-- Search Locker --</option>
                </select>
            </div>

            <div class="mb-3">
                <label class="form-label" style="color:#a0a0b0;">Student</label>
                <select asp-for="Assignment.StudentId" asp-items="Model.StudentOptions" class="form-control select2-student" style="width:100%">
                    <option value="">-- Search Student --</option>
                </select>
            </div>

            <div class="mb-3">
                <label class="form-label" style="color:#a0a0b0;">Start Date</label>
                <input asp-for="Assignment.StartDate" type="date" class="form-control bg-dark text-white border-secondary" />
            </div>

            <div class="mb-3">
                <label class="form-label" style="color:#a0a0b0;">End Date</label>
                <input asp-for="Assignment.EndDate" type="date" class="form-control bg-dark text-white border-secondary" />
            </div>

            <div class="d-flex gap-2">
                <button type="submit" class="btn-primary-custom">Save</button>
                <a href="/Assignments" class="btn btn-secondary">Cancel</a>
            </div>

        </form>
    </div>
</div>

<script src="https://cdnjs.cloudflare.com/ajax/libs/jquery/3.7.1/jquery.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/select2/4.1.0-rc.0/js/select2.min.js"></script>

<style>
    .select2-container--default .select2-selection--single {
        background-color: #1a1a2e;
        border: 1px solid #6c757d;
        border-radius: 6px;
        height: 42px;
        display: flex;
        align-items: center;
        padding: 0 10px;
    }

    .select2-container--default .select2-selection--single .select2-selection__rendered {
        color: white;
        line-height: normal;
    }

    .select2-container--default .select2-selection--single .select2-selection__arrow {
        top: 8px;
    }

    .select2-dropdown {
        background-color: #16213e;
        border: 1px solid rgba(108,99,255,0.3);
    }

    .select2-container--default .select2-results__option {
        color: #e0e0e0;
        padding: 10px;
    }

    .select2-container--default .select2-results__option--highlighted {
        background: linear-gradient(90deg, #6C63FF, #3ECFCF);
        color: white;
    }

    .select2-search--dropdown .select2-search__field {
        background: #1a1a2e;
        color: white;
        border: 1px solid rgba(108,99,255,0.3);
        border-radius: 6px;
        padding: 8px;
    }
</style>

<script>
    $(document).ready(function () {
        $('.select2-locker').select2({
            placeholder: 'Search locker...',
            allowClear: true
        });

        $('.select2-student').select2({
            placeholder: 'Search student...',
            allowClear: true
        });
    });
</script>