@page
@model Lockers.Web.Pages.Assignments.IndexModel
@{
    ViewData["Title"] = "Assignments";
}

<div class="container mt-4">
    <h2 style="color:white; font-weight:700;"><i class="fas fa-clipboard-list me-2"></i>Assignments</h2>
    <a href="/Assignments/Create" class="btn btn-primary mb-3">+ New Assignment</a>
    <table class="table table-dark table-striped table-hover">
        <thead>
            <tr>
                <th>Locker ID</th>
                <th>Student ID</th>
                <th>Start Date</th>
                <th>End Date</th>
                <th>Active</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var assignment in Model.AssignmentList)
            {
                <tr>
                    <td>@assignment.LockerId</td>
                    <td>@assignment.StudentId</td>
                    <td>@assignment.StartDate.ToShortDateString()</td>
                    <td>@assignment.EndDate.ToShortDateString()</td>
                    <td>@(assignment.IsActive ? "Yes" : "No")</td>
                    <td>
                        <a href="/Assignments/Renew?id=@assignment.Id" class="btn btn-sm btn-success">Renew</a>
                        <a href="/Assignments/Delete?id=@assignment.Id" class="btn btn-sm btn-danger">Delete</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>