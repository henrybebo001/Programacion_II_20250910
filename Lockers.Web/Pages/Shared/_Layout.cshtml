<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Locker Control System</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/bootstrap/5.3.2/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" />
    <style>
        :root {
            --primary: #6C63FF;
            --secondary: #3ECFCF;
            --dark: #1a1a2e;
            --card-bg: #16213e;
            --text: #e0e0e0;
        }
        body {
            background-color: var(--dark);
            color: var(--text);
            font-family: 'Segoe UI', sans-serif;
            min-height: 100vh;
        }
        .navbar {
            background: linear-gradient(90deg, #6C63FF, #3ECFCF);
            box-shadow: 0 4px 15px rgba(108, 99, 255, 0.4);
            padding: 15px 30px;
        }
        .navbar-brand {
            font-size: 1.5rem;
            font-weight: 700;
            color: white !important;
            letter-spacing: 1px;
        }
        .navbar-brand i { margin-right: 10px; }
        .nav-link {
            color: rgba(255,255,255,0.85) !important;
            font-weight: 500;
            margin: 0 5px;
            border-radius: 8px;
            padding: 8px 16px !important;
            transition: all 0.3s;
        }
        .nav-link:hover {
            background: rgba(255,255,255,0.2);
            color: white !important;
        }
        .hero {
            background: linear-gradient(135deg, #1a1a2e 0%, #16213e 50%, #0f3460 100%);
            padding: 80px 0;
            text-align: center;
            border-bottom: 1px solid rgba(108, 99, 255, 0.3);
        }
        .hero h1 {
            font-size: 3rem;
            font-weight: 800;
            background: linear-gradient(90deg, #6C63FF, #3ECFCF);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            margin-bottom: 15px;
        }
        .hero p {
            font-size: 1.2rem;
            color: #a0a0b0;
            margin-bottom: 30px;
        }
        .stats-section {
            padding: 50px 0;
            background: #16213e;
        }
        .stat-card {
            background: linear-gradient(135deg, #1a1a2e, #0f3460);
            border: 1px solid rgba(108, 99, 255, 0.3);
            border-radius: 16px;
            padding: 30px;
            text-align: center;
            transition: transform 0.3s, box-shadow 0.3s;
        }
        .stat-card:hover {
            transform: translateY(-8px);
            box-shadow: 0 20px 40px rgba(108, 99, 255, 0.3);
        }
        .stat-card i {
            font-size: 2.5rem;
            background: linear-gradient(90deg, #6C63FF, #3ECFCF);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            margin-bottom: 15px;
        }
        .stat-card h3 {
            font-size: 2rem;
            font-weight: 700;
            color: white;
        }
        .stat-card p { color: #a0a0b0; margin: 0; }
        .menu-section { padding: 60px 0; }
        .menu-card {
            background: linear-gradient(135deg, #1a1a2e, #16213e);
            border: 1px solid rgba(108, 99, 255, 0.2);
            border-radius: 20px;
            padding: 40px 30px;
            text-align: center;
            text-decoration: none;
            color: var(--text);
            display: block;
            transition: all 0.3s;
            height: 100%;
        }
        .menu-card:hover {
            transform: translateY(-10px);
            box-shadow: 0 25px 50px rgba(108, 99, 255, 0.4);
            border-color: var(--primary);
            color: white;
        }
        .menu-card .icon-wrapper {
            width: 80px;
            height: 80px;
            border-radius: 50%;
            background: linear-gradient(135deg, #6C63FF, #3ECFCF);
            display: flex;
            align-items: center;
            justify-content: center;
            margin: 0 auto 20px;
        }
        .menu-card i { font-size: 2rem; color: white; }
        .menu-card h4 { font-weight: 700; margin-bottom: 10px; color: white; }
        .menu-card p { color: #a0a0b0; font-size: 0.9rem; }
        footer {
            background: #0f0f1a;
            border-top: 1px solid rgba(108, 99, 255, 0.2);
            padding: 20px 0;
            text-align: center;
            color: #a0a0b0;
        }
        .btn-primary-custom {
            background: linear-gradient(90deg, #6C63FF, #3ECFCF);
            border: none;
            border-radius: 50px;
            padding: 12px 35px;
            font-weight: 600;
            color: white;
            text-decoration: none;
            transition: all 0.3s;
            display: inline-block;
        }
        .btn-primary-custom:hover {
            transform: scale(1.05);
            box-shadow: 0 10px 30px rgba(108, 99, 255, 0.5);
            color: white;
        }
    </style>
</head>
<body>
    <nav class="navbar navbar-expand-lg">
        <div class="container">
            <a class="navbar-brand" href="/">
                <i class="fas fa-lock"></i> LockerSystem
            </a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navMenu">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="navMenu">
                <ul class="navbar-nav ms-auto">
                    <li class="nav-item"><a class="nav-link" href="/"><i class="fas fa-home me-1"></i>Home</a></li>
                    <li class="nav-item"><a class="nav-link" href="/LockersPages"><i class="fas fa-door-closed me-1"></i>Lockers</a></li>
                    <li class="nav-item"><a class="nav-link" href="/Students"><i class="fas fa-user-graduate me-1"></i>Students</a></li>
                    <li class="nav-item"><a class="nav-link" href="/Assignments"><i class="fas fa-clipboard-list me-1"></i>Assignments</a></li>
                    <li class="nav-item"><a class="nav-link" href="/Incidents"><i class="fas fa-exclamation-triangle me-1"></i>Incidents</a></li>
                </ul>
            </div>
        </div>
    </nav>

    <main>
        @RenderBody()
    </main>

    <footer>
        <p>© 2026 Locker Control System — Built with ASP.NET Core 8</p>
    </footer>

    <script src="https://cdnjs.cloudflare.com/ajax/libs/bootstrap/5.3.2/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>